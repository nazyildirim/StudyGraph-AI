# StudyGraph AI Backend - Environment Variables Template
# Copy to .env for local development and fill in values. Never commit .env.

# PostgreSQL connection URL using psycopg 3 driver
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# JWT signing secret (required for auth endpoints, minimum 32 UTF-8 bytes)
JWT_SECRET_KEY=

# JWT claims and lifetime (optional; defaults shown in app/core/config.py)
# JWT_ISSUER=
# JWT_AUDIENCE=
# ACCESS_TOKEN_EXPIRE_MINUTES=
# JWT_LEEWAY_SECONDS=

# Argon2id password hashing parameters (optional; OWASP/RFC 9106 defaults)
# ARGON2_TIME_COST=
# ARGON2_MEMORY_COST=
# ARGON2_PARALLELISM=

# In-memory login rate limiter parameters (optional)
# LOGIN_RATE_LIMIT_ACCOUNT_MAX=
# LOGIN_RATE_LIMIT_IP_MAX=
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# RATE_LIMIT_MAX_KEYS=

# RAG & Local LLM configuration (Issue #8, optional; defaults in app/core/config.py)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# LLM_TIMEOUT_SECONDS=60.0
# LLM_CONTEXT_WINDOW=4096
# LLM_MAX_OUTPUT_TOKENS=512
# LLM_TEMPERATURE=0.2
# LLM_EXTRACTIVE_FALLBACK_ENABLED=true
# EMBEDDING_MODEL_DIR=models/multilingual-e5-small
# RETRIEVAL_STRATEGY=semantic_e5
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.81
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=10485760
# PDF_MAX_PAGES=200
# PDF_MAX_EXTRACTED_CHARS=500000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RAG_MAX_CONCURRENT_MODEL_OPS=2
